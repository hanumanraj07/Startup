# Leave empty in dev: Vite proxies /api and /socket.io to the API (see vite.config.ts).
# In production set this to the API origin, e.g. https://onsite-api.duckdns.org
VITE_API_URL=

# Web Push (VAPID public key) and Google Sign-In client id, same values apps/web uses.
VITE_VAPID_PUBLIC_KEY=
VITE_GOOGLE_CLIENT_ID=

# Dev only: where the Vite proxy forwards /api and /socket.io (default http://localhost:4000).
# VITE_DEV_API_TARGET=http://localhost:4000
# Dev only: the Origin the proxy presents; must equal the API's WEB_URL (default http://localhost:3000).
# VITE_DEV_API_ORIGIN=http://localhost:3000
