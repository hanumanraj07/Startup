# OnSite — environment template
# Copy to .env and fill in. Never commit .env.
# Configuration is validated at startup; the process refuses to boot on
# missing or malformed values rather than failing mysteriously later.

# ─── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
ROLE=api                       # "api" (HTTP + WebSocket) or "worker" (jobs only)
API_PORT=4000
# Next.js's own CLI reads the standard PORT variable directly (no WEB_PORT —
# `next dev -p ${WEB_PORT:-3000}`-style shell substitution in package.json
# scripts doesn't survive pnpm running them via cmd.exe on Windows).
PORT=3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────────
# PostGIS is required. The docker-compose service provides it.
#
# Note the database name: "onsite_app", not "onsite". The postgis Docker image
# preinstalls postgis, topology, fuzzystrmatch and tiger_geocoder into whatever
# POSTGRES_DB names, which Prisma then reports as schema drift on every
# migrate. The compose init script creates onsite_app from template0 so it
# starts with no extensions and Prisma owns postgis itself.
DATABASE_URL=postgresql://onsite:onsite@localhost:5432/onsite_app?schema=public
DATABASE_POOL_SIZE=20          # See docs/20 for the pool arithmetic. Total
                               # across all replicas must stay under
                               # max_connections minus reserved.

# ─── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Object storage ────────────────────────────────────────────────────
# Local: MinIO from docker-compose. Production: S3, R2, or equivalent.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=onsite-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true  # true for MinIO, false for S3
STORAGE_PRESIGN_TTL_SECONDS=300
UPLOAD_MAX_PHOTO_BYTES=10485760    # 10 MB
UPLOAD_MAX_VIDEO_BYTES=104857600   # 100 MB

# ─── Payments ──────────────────────────────────────────────────────────
# PAYMENT_PROVIDER=mock works fully offline with no Razorpay account.
# Real money movement additionally requires a registered business entity,
# Razorpay KYC, and Route activation. See docs/11-payment-flow.md.
PAYMENT_PROVIDER=mock          # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_COMMISSION_BPS=1500   # 1500 = 15%. Stored per task at creation.

# Statutory deductions. Leave at 0 until confirmed by a chartered
# accountant. Present from day one so enabling them is configuration,
# not a schema migration. See docs/02-business-model.md.
GST_ON_COMMISSION_BPS=0
TCS_BPS=0
TDS_194O_BPS=0

# Worker payouts. mock settles instantly (an account ending 0000 is declined);
# none keeps payouts owed and visible. Unset = none in production, mock elsewhere.
# PAYOUT_PROVIDER=mock         # mock | none
PAYOUT_MAX_ATTEMPTS=5

# ─── Identity and bank verification ───────────────────────────────────
# DigiLocker identity checks and bank/UPI account checks (ai/memory.md, P4).
# Unset = none in production (manual document review only), mock elsewhere.
# The mock's DigiLocker is an in-app test page; never used in production.
# VERIFICATION_PROVIDER=mock   # mock | cashfree | none
CASHFREE_VERIFICATION_CLIENT_ID=
CASHFREE_VERIFICATION_CLIENT_SECRET=
# Sandbox by default; production is https://api.cashfree.com/verification
CASHFREE_VERIFICATION_BASE_URL=https://sandbox.cashfree.com/verification
CASHFREE_VERIFICATION_API_VERSION=2024-12-01

# ─── Maps and geocoding ────────────────────────────────────────────────
# OpenStreetMap end to end (founder decision, 2026-10-19): the map picker's
# place search and "what's here" lookups go through the API to Photon
# (https://photon.komoot.io, OSM data, no key, fair use), and the map shows
# OpenStreetMap tiles via MapLibre. "mock" returns a few canned places, for
# tests and offline work. See docs/05-system-architecture.md.
GEOCODING_PROVIDER=osm         # osm | mock
GEOCODING_OSM_URL=https://photon.komoot.io
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Sign-in with Google. From a Google Cloud Console OAuth client (type: Web
# application) with this app's origin under "Authorized JavaScript origins".
# Only the client ID needs to reach the browser (NEXT_PUBLIC_ prefix, set in
# apps/web/.env.local); the secret is kept here for the API only and is not
# used by the ID-token verification flow this app currently implements.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The web app calls the API directly from the browser, so this must be
# reachable from wherever the browser runs — not just from the API's own
# host. Next.js only reads NEXT_PUBLIC_* from apps/web/.env.local, not this
# root file, since it has no monorepo-root env loading of its own.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Moderation ────────────────────────────────────────────────────────
# Optional. When set, every task title and description is also checked by the
# OpenAI Moderation API (free for API accounts) on top of the keyword rules.
# Task text is sent to OpenAI. Leave empty to use the keyword rules only.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
# How long a user is blocked from posting after a moderation violation.
MODERATION_COOLDOWN_SECONDS=300

# ─── Notifications ─────────────────────────────────────────────────────
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

EMAIL_PROVIDER=console         # console | smtp | resend
EMAIL_FROM=OnSite <no-reply@example.com>
SMTP_URL=

# SMS requires Indian DLT registration. "console" prints OTPs to the
# terminal so the entire phone verification flow works without a provider.
SMS_PROVIDER=console           # console | msg91 | twilio
SMS_API_KEY=
SMS_SENDER_ID=

# ─── Business rules ────────────────────────────────────────────────────
REVIEW_WINDOW_HOURS=24         # Auto-approval deadline after submission
DISPUTE_WINDOW_DAYS=7
MIN_TASK_BUDGET_PAISE=30000    # ₹300 — below this, fixed costs dominate
MAX_TASK_BUDGET_PAISE=5000000  # ₹50,000
MAX_CONCURRENT_TASKS_PER_WORKER=3
DEFAULT_WORKER_RADIUS_M=10000
MATCH_TIER_RADII_M=3000,7000,15000,30000
MATCH_TIER_WAIT_MINUTES=10,15,20

# ─── Observability ─────────────────────────────────────────────────────
LOG_LEVEL=debug                # debug | info | warn | error
SENTRY_DSN=
