{
  "name": "@onsite/web-owl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .tsbuildinfo"
  },
  "dependencies": {
    "@odoo/owl": "^2.8.3",
    "@onsite/money": "workspace:*",
    "@onsite/types": "workspace:*",
    "@onsite/utils": "workspace:*",
    "@onsite/validation": "workspace:*",
    "lucide": "^0.469.0",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@onsite/config": "workspace:*",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.6"
  }
