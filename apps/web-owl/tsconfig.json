{
  "extends": "@onsite/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "noEmit": true,
    "isolatedModules": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@onsite/types": ["../../packages/types/src/index.ts"],
      "@onsite/validation": ["../../packages/validation/src/index.ts"],
      "@onsite/money": ["../../packages/money/src/index.ts"],
      "@onsite/utils": ["../../packages/utils/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts", "tailwind.config.ts"],
  "exclude": ["node_modules", "dist"]
}
